								size = { 710 40 }
								position = { 10 -20 }
								
								textbox = {
									text = "LOBBY_JOURNAL_ENTRIES"
									parentanchor = center
									position = { 0 -2 }
									autoresize = yes
									elide = right
									using = fontsize_xl
								}
								blockoverride "text" { }
							}
							
							flowcontainer = {
								datamodel = "[AccessPlayer.GetLobbyJournalEntries]"
								direction = vertical
								margin_left = 10
								spacing = 5
								
								item = {
									flowcontainer = {
										direction = horizontal
										margin_left = 5
										tooltip = "LOBBY_JOURNAL_ENTRY_TOOLTIP"
										
										background = {
											using = dark_area
											alpha = 0.2
											
											modify_texture = {
												texture = "gfx/interface/masks/fade_horizontal_right.dds"
												spriteType = Corneredstretched
												spriteborder = { 0 0 }
												blend_mode = alphamultiply
											}
										}
										
										icon = {
											size = { 30 30 }
											texture = "[JournalEntryType.GetIcon]"
											parentanchor = vcenter
										}
										
										widget = {
											size = { 600 40 }
											textbox = {
												text = "[JournalEntryType.GetName]"
												position = { 10 0 }
												parentanchor = vcenter
												autoresize = yes
												align = nobaseline
											}
										}
									}
								}
							}
						}
						
						flowcontainer = {
							parentanchor = top|hcenter
							direction = vertical
							visible = "[Not(IsDataModelEmpty(AccessPlayer.AccessActiveJournalEntries))]"
							margin_top = 15
							margin_left = 15
							spacing = 5
							
							default_header_clean_faded = {
								parentanchor = top|hcenter
								size = { 710 40 }
								
								textbox = {
									text = "com_intro_window_active_journal_entries"
									parentanchor = center
									position = { 0 -2 }
									autoresize = yes
									elide = right
									using = fontsize_xl
								}
								blockoverride "text" { }
							}
							
							flowcontainer = {
								direction = vertical
								parentanchor = left|top
								margin_top = 5
								minimumsize = { 680 -11 }
								spacing = 10
								margin_left = 10
								margin_bottom = 10
								
								datamodel = "[AccessPlayer.GetGroupsForActiveJournalEntries]"
								
								background = {
									using = entry_bg_fancy_dark
									margin = { 5 5 }
								}
								
								item = {
									flowcontainer = {
										direction = vertical
										
										textbox = {
											text = "[JournalEntryGroup.GetName]"
											autoresize = yes
											align = nobaseline
											default_format = "#title"
											margin_left = 3
										}
										
										flowcontainer = {
											direction = vertical
											datamodel = "[JournalEntryGroup.GetActiveJournalEntryTypes(GetPlayer.Self)]"
											spacing = 2
											
											background = {
												using = dark_area
												alpha = 0.2
												
												modify_texture = {
													texture = "gfx/interface/masks/fade_horizontal_right.dds"
													spriteType = Corneredstretched
													spriteborder = { 0 0 }
													blend_mode = alphamultiply
												}
											}
											
											item = {
												flowcontainer = {
													direction = horizontal
													margin_left = 5
													datacontext = "[AccessPlayer.GetJournalEntry(JournalEntryType.Self)]"
													
													icon = {
														size = { 30 30 }
														texture = "[JournalEntryType.GetIcon]"
														parentanchor = vcenter
													}
													
													widget = {
														size = { 560 40 }
														textbox = {
															text = "[JournalEntryType.GetName]"
															position = { 10 0 }
															parentanchor = vcenter
															autoresize = yes
															align = nobaseline
														}
													}
													
													icon = {
														datacontext = "[AccessPlayer.GetJournalEntry(JournalEntryType.GetKey)]"
														size = { 30 30 }
														parentanchor = right|vcenter
														visible = "[JournalEntry.IsDLCContent]"
														texture = "[JournalEntry.GetDLCIcon]"
														tooltip = "JOURNAL_ENTRY_DLC_TOOLTIP"
													}
												}
											}
										}
									}
								}
							}
						}
						
						default_header_clean_faded = {
							parentanchor = top|hcenter
							size = { 710 40 }
							visible = "[Or(
								GetPlayer.MakeScope.Var('com_intro_window_content_text').IsSet,
								Not(StringIsEmpty(EventWindow.GetFlavor))
							)]"
							
							textbox = {
								text = "com_intro_window_content_header"
								parentanchor = center
								position = { 0 -2 }
								autoresize = yes
								elide = right
								using = fontsize_xl
							}
							blockoverride "text" { }
						}
						
						textbox = {
							maximumsize = { 710 -1 }
							visible = "[Not(StringIsEmpty(EventWindow.GetFlavor))]"
							multiline = yes
							autoresize = yes
							parentanchor = top|hcenter
							align = nobaseline
							raw_text = "#bold [EventWindow.GetFlavor]#!"
							margin = { 10 0 }
							using = fontsize_medium
						}
						
						textbox = {
							maximumsize = { 720 -1 }
							visible = "[GetPlayer.MakeScope.Var('com_intro_window_content_text').IsSet]"
							parentanchor = top|hcenter
							multiline = yes
							autoresize = yes
							align = nobaseline
							margin = { 10 0 }
							using = fontsize_medium
							text = "com_intro_window_content_text"
						}
					}
				}
			}
		}
	}
	
	type com_introduction_europa_option_button = flowcontainer {
		parentanchor = top|hcenter
		direction = vertical
		using = default_list_position
		datamodel = "[EventWindow.GetOptions]"
		margin_top = 10
		
		item = {
			container = {
				widget = {
					button = {
						size = { 96% 90% }
						parentanchor = hcenter
						using = default_button_primary_action
						tooltip = "[EventOption.GetDesc]"
						using = tooltip_ws
						using = confirm_button_sound
						onclick = "[EventOption.Select]"
					}
					
					textbox = {
						position = { 0 -2 }
						resizeparent = yes
						minimumsize = { 500 42 }
						maximumsize = { 500 -1 }
						align = "center"
						autoresize = yes
						margin = { 30 10 }
						text = "com_intro_window_event_option"
					}
				}
			}
		}
	}
}