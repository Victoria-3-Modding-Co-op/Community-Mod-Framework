	type com_introduction_europa_environment_tab = widget {
		parentanchor = top|hcenter
		size = { 700 400 }
		
		visible = "[GetVariableSystem.HasValue('com_introduction_europa_tab', 'environment')]"
		
		background = {
			margin = { 10 10 }
			using = light_bg
			using = frame_small_mask
			
			block "entry_bg_fancy_bg_alpha" {
				alpha = 0.8
			}
		}
		
		background = {
			margin = { 10 10 }
			using = frame_small
		}
		
		flowcontainer = {
			parentanchor = top|hcenter
			direction = vertical
			spacing = 10
			
			scrollarea = {
				parentanchor = top|hcenter
				minimumsize = { 720 400 }
				maximumsize = { 720 -1 }
				
				using = default_list_position
				layoutpolicy_vertical = expanding
				layoutpolicy_horizontal = preferred
				
				scrollbarpolicy_horizontal = always_off
				
				scrollbar_vertical = {
					using = vertical_scrollbar
				}
				
				scrollwidget = {
					flowcontainer = {
						parentanchor = top|hcenter
						direction = vertical
						
						default_header_clean_faded = {
							parentanchor = top|hcenter
							size = { 710 40 }
							position = { 10 -20 }
							
							textbox = {
								text = "com_intro_window_region_header"
								parentanchor = center
								position = { 0 -2 }
								autoresize = yes
								elide = right
								using = fontsize_xl
							}
							blockoverride "text" { }
						}
						
						textbox = {
							maximumsize = { 720 -1 }
							parentanchor = top|hcenter
							multiline = yes
							autoresize = yes
							align = nobaseline
							margin = { 10 0 }
							using = fontsize_medium
							text = "com_intro_window_region_body"
						}
						
						default_header_clean_faded = {
							parentanchor = top|hcenter
							size = { 710 40 }
							position = { 10 -20 }
							
							visible = "[Not(IsDataModelEmpty(AccessPlayer.GetSubjects))]"
							
							textbox = {
								raw_text = "Subjects and Dependencies"
								parentanchor = center
								position = { 0 -2 }
								autoresize = yes
								elide = right
								using = fontsize_xl
							}
							blockoverride "text" { }
						}
						
						flowcontainer = {
							parentanchor = top|hcenter
							direction = vertical
							spacing = 5
							
							visible = "[Not(IsDataModelEmpty(AccessPlayer.GetSubjects))]"
							
							datamodel = "[AccessPlayer.GetSubjects]"
							
							item = {
								flowcontainer = {
									visible = "[Country.IsSubject]"
									
									textbox = {
										minimumsize = { 250 -1 }
										maximumsize = { 250 -1 }
										autoresize = yes
										align = nobaseline
										elide = right
										fontsize_min = 12
										using = fontsize_large
										raw_text = "[Country.GetName]"
									}
									
									textbox = {
										minimumsize = { 100 -1 }
										maximumsize = { 100 -1 }
										autoresize = yes
										align = nobaseline
										raw_text = "[Country.GetDefinition.GetTier]"
									}
									
									textbox = {
										minimumsize = { 200 -1 }
										maximumsize = { 200 -1 }
										autoresize = yes
										align = nobaseline
										raw_text = "[Country.GetSubjectType.GetName]"
									}
									
									textbox = {
										minimumsize = { 100 -1 }
										maximumsize = { 100 -1 }
										autoresize = yes
										align = nobaseline
										raw_text = "[Country.GetCapital.GetStateRegion.GetStrategicRegion.GetName]"
									}
								}
							}
						}
					}
				}
			}
		}
	}
	
