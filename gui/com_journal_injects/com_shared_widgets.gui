# INHERITED FROM BASE GAME
@panel_width_minus_30 = 510
@panel_width_minus_20 = 520
@panel_width_minus_10 = 530 # used to be 450
@panel_width = 540 # used to be 460
@panel_width_half = 270 # used to be 230
@panel_width_plus_10 = 550 # used to be 470
@panel_width_plus_14 = 554 # used to be 474
@panel_width_plus_14_half = 277 # used to be 237
@panel_width_plus_20 = 560 # used to be 480
@panel_width_plus_30 = 570 # used to be 490
@panel_width_plus_70 = 610 # used to be 530

####---------- CMF Framework Widgets ----------####
flowcontainer = {
	name = "com_journal_modifiers_container"
	ignoreinvisible = yes

	flowcontainer = {
		direction = vertical
		spacing = 5
		com_journal_modifiers_container = {}
	}
}

flowcontainer = {
	name = "com_journal_scripted_buttons"
	ignoreinvisible = yes

	flowcontainer = {
		direction = vertical
		spacing = 5
		com_journal_scripted_buttons = {}
	}
}

flowcontainer = {
	name = "com_journal_reason_text"
	ignoreinvisible = yes

	flowcontainer = {
		direction = vertical
		spacing = 5
		com_journal_reason_text = {}
	}
}

flowcontainer = {
	name = "com_journal_involved_countries"
	ignoreinvisible = yes

	flowcontainer = {
		direction = vertical
		spacing = 5
		com_journal_involved_countries = {}
	}
}

flowcontainer = {
	name = "com_journal_involved_countries_tiny_flags"
	ignoreinvisible = yes

	flowcontainer = {
		direction = vertical
		spacing = 5
		com_journal_involved_countries_tiny_flags = {}
	}
}

flowcontainer = {
	name = "com_journal_involved_countries_tiny_flags_with_scrollbar"
	ignoreinvisible = yes

	flowcontainer = {
		direction = vertical
		spacing = 5
		com_journal_involved_countries_tiny_flags_with_scrollbar = {}
	}
}


####---------- CMF Framework Shared Types ----------####
types com_journal_widget_types {
	type com_journal_modifiers_container = flowcontainer {
		visible = "[Not(IsDataModelEmpty(JournalEntry.GetTimedModifiers))]"
		direction = vertical
		parentanchor = top|hcenter
		minimumsize = { 540 -1 }
		using = entry_bg_fancy
		spacing = 10
		margin_bottom = 20

		default_header_clean_faded = {
			parentanchor = hcenter
			blockoverride "text" {
				text = "MODIFIERS"
			}
			blockoverride "size" {
				size = { 532 45 }
			}
		}

		flowcontainer = {
			datamodel = "[JournalEntry.GetTimedModifiers]"
			spacing = 5
			minimumsize = { 500 -1 }
			parentanchor = hcenter
			direction = vertical

			item = {
				container = {
					minimumsize = { 500 -1 }
					tooltip = "[TimedModifier.GetTooltip]"

					flowcontainer = {
						spacing = 10

						icon = {
							texture = "[TimedModifier.GetIcon]"
							size = { 25 25 }
						}

						textbox = {
							text = "[TimedModifier.GetName]"
							autoresize = yes
							align = nobaseline
							parentanchor = vcenter
						}
					}

					textbox = {
						text = "[TimedModifier.GetRemainingDuration]"
						autoresize = yes
						align = nobaseline
						parentanchor = right|vcenter
					}
				}
			}
		}
	}

	type com_journal_scripted_buttons = flowcontainer {
		direction = vertical
		parentanchor = top|hcenter
		minimumsize = { 540 -1 }
		using = entry_bg_fancy
		spacing = 10
		margin_bottom = 20

		visible = "[Not( IsDataModelEmpty( JournalEntry.GetScriptedButtons ) )]"

		default_header_clean_faded = {
			parentanchor = hcenter
			blockoverride "text" {
				text = "com_gui_main_actions"
			}
			blockoverride "size" {
				size = { 532 45 }
			}
		}

		flowcontainer = {
			parentanchor = top|hcenter
			direction = vertical
			spacing = 5

			datamodel = "[JournalEntry.GetScriptedButtons]"

			item = {
				widget = {
					size = { 400 40 }
					com_journal_scripted_button_item = { }
				}
			}
		}
	}

	type com_journal_scripted_button_item = button {
		parentanchor = center
		using = default_button_action
		tooltip = "SCRIPTED_ACTION_TOOLTIP"
		enabled = "[IsValid( ScriptedButton.ExecuteEffect )]"
		onclick = "[Execute( ScriptedButton.ExecuteEffect )]"
		size = { 460 38 }
		margin = { 20 20 }

		widget = {
			visible = "[ScriptedButton.IsSelected]"
			size = { 100% 100% }

			background = {
				using = paper_bg
			}
		}

		textbox = {
			parentanchor = center
			align = nobaseline
			autoresize = yes
			max_width = 300
			elide = right
			fontsize_min = 14
			text = "[ScriptedButton.GetName]"
		}

		icon = {
			visible = "[ScriptedButton.IsSelected]"
			using = highlighted_square_selection
		}
	}
	
	type com_journal_timeout_info = flowcontainer {
		visible = "[And(JournalEntry.CanTimeOut, JournalEntry.IsActive)]"
		spacing = 5
		
		icon = {
			size = { 18 18 }
			texture = "gfx/interface/icons/generic_icons/clock.dds"
			parentanchor = vcenter
		}
		textbox = {
			text = "[JournalEntry.GetTimeoutTooltip]"
			autoresize = yes
			align = left|nobaseline
			parentanchor = vcenter
		}
	}
	
	type com_journal_reason_text = flowcontainer {
		parentanchor = top|hcenter
		spacing = 5
		
		# Default Reason Text
		textbox = {
			visible = "[Not(StringIsEmpty(JournalEntry.GetReason))]"
			
			text = "[JournalEntry.GetReason]"
			min_width = 535
			max_width = 535
			multiline = yes
			using = default_list_position
			align = nobaseline
			margin = { 15 15 }
			autoresize = yes
			
			background = {
				using = entry_bg
			}
		}
		
		# Reason Text Box #2
		textbox = {
			visible = "[Not(ObjectsEqual(
				Localize(Concatenate('JournalEntry.GetKey', '_reason_2')),
				Concatenate(Localize('JournalEntry.GetKey'), '_reason_2'))
			))]"
			
			text = "[Concatenate(Localize('JournalEntry.GetKey'), '_reason_2'))]"
			min_width = 535
			max_width = 535
			multiline = yes
			using = default_list_position
			align = nobaseline
			margin = { 15 15 }
			autoresize = yes
			
			background = {
				using = entry_bg
			}
		}
	}

	type com_journal_involved_countries = flowcontainer {
		direction = vertical
		parentanchor = top|hcenter
		minimumsize = { 540 -1 }
		using = entry_bg_fancy
		spacing = 10
		margin_bottom = 20

		block "com_involved_countries_header" {
			default_header_clean_faded = {
				parentanchor = hcenter
				blockoverride "text" {
					text = "com_gui_members"
				}
				blockoverride "size" {
					size = { 532 45 }
				}
			}
		}

		flowcontainer = {
			direction = vertical
			using = default_list_position
			min_width = @panel_width_minus_30
			max_width = @panel_width_minus_30

			dynamicgridbox = {
				parentanchor = hcenter
				datamodel = "[JournalEntry.GetInvolvedCountries]"
				datamodel_wrap = 8
				flipdirection = yes

				item = {
					widget = {
						size = { 60 30 }

						small_flag = { }
					}
				}
			}
		}
	}

	type com_journal_involved_countries_tiny_flags = flowcontainer {
		direction = vertical
		parentanchor = top|hcenter
		minimumsize = { 500 -1 }
		width = 515
		using = entry_bg_fancy
		spacing = 10
		margin_bottom = 20

		block "com_involved_countries_header" {
			default_header_clean_faded = {
				parentanchor = hcenter
				blockoverride "text" {
					text = "com_gui_members"
				}
				blockoverride "size" {
					size = { 512 45 }
				}
			}
		}

		flowcontainer = {
			direction = vertical
			using = default_list_position
			min_width = @panel_width_minus_30
			max_width = @panel_width_minus_30

			dynamicgridbox = {
				parentanchor = hcenter
				datamodel = "[JournalEntry.GetInvolvedCountries]"
				datamodel_wrap = 14
				flipdirection = yes

				item = {
					widget = {
						size = { 34 24 }

						tiny_flag = { }
					}
				}
			}
		}
	}

	type com_journal_involved_countries_tiny_flags_with_scrollbar = flowcontainer {
		direction = vertical
		parentanchor = top|hcenter
		minimumsize = { 500 -1 }
		using = entry_bg_fancy
		spacing = 10
		margin_bottom = 20

		block "com_involved_countries_header" {
			default_header_clean_faded = {
				parentanchor = hcenter
				blockoverride "text" {
					text = "com_gui_members"
				}
				blockoverride "size" {
					size = { 512 45 }
				}
			}
		}

		scrollbox = {
			size = { 98% 45 }

			scrollbarpolicy_horizontal = always_off
			scrollbarpolicy_vertical = as_needed

			scrollbar_vertical = {
				using = vertical_scrollbar
			}

			blockoverride "scrollbox_background" {}

			blockoverride "scrollbox_content" {
				layoutpolicy_horizontal = expanding
				margin_top = 2
				margin_left = 20
				margin_bottom = 0

				using = default_list_position
					min_width = 485
					max_width = 485

				dynamicgridbox = {
					datamodel = "[JournalEntry.GetInvolvedCountries]"
					datamodel_wrap = 14
					flipdirection = yes

					item = {
						widget = {
							size = { 34 24 }

							tiny_flag = { }
						}
					}
				}
			}
		}
	}

	type com_journal_entry_frame_text = widget {
		background = {
			using = dark_area
			alpha = 0.75

			modify_texture = {
				texture = "gfx/interface/masks/fade_horizontal_left_full.dds"
				blend_mode = alphamultiply
			}
		}

		size = { 250 53 }

		divider_clean = {
			parentanchor = top
		}
		divider_clean = {
			parentanchor = bottom
		}

		hbox = {
			margin_right = 13
			margin_left = 10
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			spacing = 7

			vbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				margin = { 0 7 }
				spacing = 3

				textbox = {
					layoutpolicy_horizontal = expanding
					size = { 0 16 }
					block "text_top" {
						raw_text = "#r frame_text text_top#!"
					}
					align = right|vcenter
					elide = right
					fontsize_min = 12
				}

				textbox = {
					layoutpolicy_horizontal = expanding
					size = { 0 20 }
					block "text" {
						raw_text = "#r frame_text text#!"
					}
					align = right|vcenter
					elide = right
					fontsize_min = 12
					using = fontsize_large
				}
			}

			icon = {
				size = { 35 35 }
				block "icon" {
					texture = gfx/interface/icons/alert_icons/placeholder.dds
				}
			}
		}
	}
}

types com_legacy_journal_widget_types {
	# These exist to provide links for renamed gui types
	type com_international_organization_reason = com_journal_reason_text {}
	type com_international_organization_buttons = com_journal_scripted_buttons {}
	type com_international_organization_button = com_journal_scripted_button_item {}
	type com_international_organization_modifiers = com_journal_modifiers_container {}
	type com_international_organization_members = com_journal_involved_countries {}
}