### Rebuilt by Alexedishi for CMF, ping me if something's broken
widget = {
	name = "error_deer"
	parentanchor = bottom|hcenter
	size = { 300 120 } # Increased from base game for buffer
	position = { 480 4 } # Inherited from base game
	layer = layer_error_deer
	using = clickthrough_blocker
	allow_outside = yes
	
	visible = "[And4(
		InDebugMode,
		ErrorDeer.HasErrors,
		IsInGame,
		Or(
			IsGamePaused,
			Not(GetVariableSystem.Exists('com_debug_deer_unlocked'))
		)
	)]"
	
	onmousehierarchyenter = "[SetCanOpenRightClickContextMenu( '(bool)no' )]"
	onmousehierarchyleave = "[SetCanOpenRightClickContextMenu( '(bool)yes' )]"
	
	state = {
		name = _show
		duration = 0.1
		position_y = 0
		using = Animation_Curve_Default
	}
	state = {
		name = _hide
		duration = 0.1
		position_y = 12
		using = Animation_Curve_Default
	}
	
	# CMF Error Deer Settings Button Visibility
	onmousehierarchyenter = "[GetVariableSystem.Set('error_deer_config', 'true')]"
	onmousehierarchyleave = "[GetVariableSystem.Clear('error_deer_config')]"
	onmousehierarchyleave = "[GetVariableSystem.Clear('com_show_icon_config')]"
	
	## ERROR DEER BUTTON / ICON
	# Always make sure this first instance points to the current error deer icon in the latest release version
	# As of 1.15.0, it is gfx/interface/error_lion.dds
	com_error_deer_button = {
		blockoverride "icon_visibility" {
			visible = "[Not(GetGlobalVariable('com_error_deer_icon_var').IsSet)]"
		}
		blockoverride "icon_texture" {
			texture = "gfx/interface/error_lion.dds" # Accurate as of patch 1.15.0
		}
	}
	com_error_deer_button = {
		blockoverride "icon_visibility" {
			visible = "[GetGlobalVariable('com_error_deer_icon_var').IsSet]"
		}
		blockoverride "icon_texture" {
			texture = "[GetGlobalVariable('com_error_deer_icon_var').GetInterestGroupTrait.GetTexture]"
		}
	}
	
	# ERROR COUNTER STRING
	textbox = {
		name = "error_counter"
		parentanchor = bottom|right
		position = { 10 0 }
		
		visible = "[And(ErrorDeer.HasErrors, IsInGame)]"
		
		text = "com_error_counter"
		autoresize = yes
		align = center|nobaseline
		multiline = yes
		using = fontsize_large
		tooltip = "com_error_counter_tooltip"
		max_width = 210
		
		background = {
			using = dark_area
			alpha = 0.4
			margin = { 5 0 }
		}
	}
	
	
	## ERROR DEER WIDGET SETTINGS
	button = {
		texture = "gfx/interface/backgrounds/round_button_bg.dds"
		size = { 30 30 }
		position = { 5 75 }
		visible = "[GetVariableSystem.Exists('error_deer_config')]"
		onclick = "[GetVariableSystem.Toggle('com_debug_deer_unlocked')]"
		
		state = {
			name = _show
			using = default_show_properties
		}
		state = {
			name = _hide
			using = default_hide_properties
		}
		
		icon = {
			size = { 25 25 }
			position = { 1 0 }
			parentanchor = center
			texture = "gfx/interface/buttons/button_icons/lock.dds"
			visible = "[Not(GetVariableSystem.Exists('com_debug_deer_unlocked'))]"
			tooltip = "com_release_manul"
		}
		icon = {
			size = { 25  25 }
			position = { 1 0 }
			parentanchor = center
			texture = "gfx/interface/buttons/button_icons/unlock.dds"
			visible = "[GetVariableSystem.Exists('com_debug_deer_unlocked')]"
			tooltip = "com_contain_manul" # MANUL CANNOT BE TAMED
		}
	}
	button = {
		texture = "gfx/interface/backgrounds/round_button_bg.dds"
		size = { 30 30 }
		position = { 5 45 }
		visible = "[GetVariableSystem.Exists('error_deer_config')]"
		onclick = "[GetVariableSystem.Toggle('com_show_icon_config')]"
		
		state = {
			name = _show
			using = default_show_properties
		}
		state = {
			name = _hide
			using = default_hide_properties
		}
		
		icon = {
			size = { 25 25 }
			position = { 1 0 }
			parentanchor = center
			texture = "gfx/interface/buttons/button_icons/other.dds"
			visible = "[Not(GetVariableSystem.Exists('com_show_icon_config'))]"
		}
		icon = {
			size = { 25  25 }
			position = { 1 0 }
			parentanchor = center
			texture = "gfx/interface/buttons/button_icons/move_right.dds"
			visible = "[GetVariableSystem.Exists('com_show_icon_config')]"
		}
	}
	
	## ERROR DEER ICON SELECTION CONTAINER
	com_error_deer_icon_selector = {}
}

types com_error_deer_icon_types {
	type com_error_deer_button = button {
		# Positions have been adjusted to keep this widget within the parent container to avoid confusion
		parentanchor = left|vcenter
		position = { 20 0 }
		size = { 100 120 }
		tooltip = "com_error_deer_tooltip"
		
		block "icon_visibility" {}
		
		block "icon_texture" {
			texture = "gfx/interface/error_frog.dds" # This is to spook you if you mess up, Alex
		}
		
		state = {
			trigger_on_create = yes
			name = 1
			next = 2
			
			duration = 1
			using = Animation_Curve_Default
			position = { 30 0 }
		}
		state = {
			name = 2
			next = 1
			
			duration = 1
			using = Animation_Curve_Default
			position = { 20 0 }
		}
		
		click_modifiers = {
			ondefault = "[ExecuteConsoleCommandsForced('log_status')]"
			onshift = "[ExecuteConsoleCommandsForced('explorer')]"
			onalt = "[ExecuteConsoleCommandsForced('TickTask.List')]"
		}
		rightclick_modifiers = {
			ondefault = "[ExecuteConsoleCommandsForced('Log.ResetErrorCount;Log.clearerrorlog')]"
			onshift = "[ExecuteConsoleCommandsForced('3dstats')]"
			onalt = "[ExecuteConsoleCommandsForced('tweak')]"
		}
	}
	
	type com_error_deer_icon_selector = flowcontainer {
		# This is typed only because it makes the primary widget script hell to read through
		direction = vertical
		parentanchor = left|vcenter
		position = { 40 0 }
		
		using = clickthrough_blocker
		
		visible = "[GetVariableSystem.Exists('com_show_icon_config')]"
		
		state = {
			name = _show
			using = default_show_properties
		}
		state = {
			name = _hide
			using = default_hide_properties
		}
		
		background = {
			using = dark_area
			alpha = 0.5
		}
		
		flowcontainer = {
			direction = horizontal
			parentanchor = top|hcenter
			minimumsize = { 255 -1 }
			spacing = 2
			
			button = {
				parentanchor = top|hcenter
				texture = "gfx/interface/backgrounds/round_button_bg.dds"
				size = { 40 40 }
				onclick = "[GetScriptedGui('com_reset_error_deer_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				onclick = "[GetVariableSystem.Clear('com_show_icon_config')]"
				icon = {
					size = { 35 35 }
					position = { 1 0 }
					parentanchor = center
					texture = "gfx/interface/buttons/button_icons/reset.dds"
				}
			}
			
			vertical_divider_stronger_full = {
				parentanchor = top|hcenter
			}
			
			dynamicgridbox = {
				parentanchor = top|hcenter
				datamodel = "[GetGlobalList('com_error_deer_icon_list')]"
				datamodel_wrap = 5
				flipdirection = yes
				
				item = {
					widget = {
						size = { 45 40 } # spacing buffer; it doesn't need much
						button = {
							size = { 40 40 }
							texture = "gfx/interface/backgrounds/round_button_bg.dds"
							datacontext = "[Scope.GetInterestGroupTrait]"
							
							onclick = "[GetScriptedGui('com_set_error_deer_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'icon', InterestGroupTrait.MakeScope).End )]"
							onclick = "[GetVariableSystem.Clear('com_show_icon_config')]"
							
							icon = {
								size = { 25 25 }
								position = { 1 0 }
								parentanchor = center
								texture = "[InterestGroupTrait.GetTexture]"
							}
						}
					}
				}
			}
		}
	}
}